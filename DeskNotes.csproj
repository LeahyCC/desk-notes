<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>DeskNotes.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only here for NotifyIcon (the tray icon). WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskNotes</AssemblyName>
    <RootNamespace>DeskNotes</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>DeskNotes</Product>
    <Authors>Colin Leahy</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds a global using that clashes with WPF names. We qualify Forms by hand. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <!-- The tray loads the same icon the exe carries. -->
    <Resource Include="DeskNotes.ico" />
  </ItemGroup>

</Project>
